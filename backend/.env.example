# =========================================================================
# Patient Management System (PMS) - Backend Configuration Template
# Copy this file to '.env' and fill in your connection credentials.
# =========================================================================

# The application environment: 'development' or 'production'
ENVIRONMENT=development

# Database Connection (Neon DB / PostgreSQL)
# Leave this commented out or blank to default to SQLite for local development.
# DATABASE_URL=postgresql://user:password@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require

# SQLite database file path (optional, only used if DATABASE_URL is not set)
# DATABASE_PATH=pms_lite.db

# JWT Authentication Config
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
